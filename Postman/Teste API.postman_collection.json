    {
      "name": "01 - Criação de Pedidos",
      "item": [
        {
          "name": "POST /orders (Happy Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 201 Created\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Retornou id no response\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property(\"id\");\r",
                  "    pm.environment.set(\"currentOrderId\", jsonData.id);  // usa \"id\" do mock\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"orderId\": \"TESTE-{{ $timestamp }}\",\r\n  \"customer\": \"Alexandre Teste\",\r\n  \"total\": 299.90,\r\n  \"status\": \"PENDING\",\r\n  \"code\": \"ORDER-{{ $timestamp }}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/orders",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "orders"
                  ]
                }
              },
              "code": 201,
              "_postman_previewlanguage": null,
              "header": null,
              "cookie": [],
              "body": "{\r\n  \"id\": 1\r\n}\r\n"
            }
          ]
        }
      ]
