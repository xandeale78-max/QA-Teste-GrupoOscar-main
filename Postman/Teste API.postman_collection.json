    {
      "name": "04 - Idempotência",
      "item": [
        {
          "name": "POST /orders - Teste de Idempotência-Criação",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Criou pedido - 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "idemp-123",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"orderId\": \"ORDER-001\",\r\n  \"customer\": \"Teste Idempotência\",\r\n  \"total\": 150\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST /orders - Teste de Idempotência-Duplicidade",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const duplicated = pm.environment.get(\"duplicated\");\r",
                  "\r",
                  "if (duplicated === \"true\") {\r",
                  "  pm.test(\"Rejeitou duplicado - 409 (simulado)\", function () {\r",
                  "    pm.expect.fail(\"Simulação: pedido duplicado deveria retornar 409\");\r",
                  "  });\r",
                  "} else {\r",
                  "  pm.test(\"Criou pedido - 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "  });\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const orderId = pm.request.body.raw\r",
                  "  ? JSON.parse(pm.request.body.raw).orderId\r",
                  "  : null;\r",
                  "\r",
                  "if (orderId) {\r",
                  "  const saved = pm.environment.get(\"lastOrderId\");\r",
                  "\r",
                  "  if (saved === orderId) {\r",
                  "    pm.environment.set(\"duplicated\", \"true\");\r",
                  "  } else {\r",
                  "    pm.environment.set(\"duplicated\", \"false\");\r",
                  "    pm.environment.set(\"lastOrderId\", orderId);\r",
                  "  }\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "idemp-123",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"orderId\": \"ORDER-001\",\r\n  \"customer\": \"Teste Idempotência\",\r\n  \"total\": 150\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
